{
  "name": "@floez-werk/piagent-realtime-provider-cost",
  "version": "0.12.0",
  "description": "Pi extension: shows the effective token prices (input/output, per 1M tokens) of the provider/model of the last API call in the status bar.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "cost",
    "tokens",
    "statusbar"
  ],
  "license": "MIT",
  "author": "FloezWerk",
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloezWerk/piagent-realtime-provider-cost.git"
  },
  "homepage": "https://github.com/FloezWerk/piagent-realtime-provider-cost#readme",
  "bugs": {
    "url": "https://github.com/FloezWerk/piagent-realtime-provider-cost/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "readme": "npx -y @floez-werk/pi-extension-release-tool@^0.1 sync-readme",
    "release-notes": "npx -y @floez-werk/pi-extension-release-tool@^0.1 release-notes",
    "check": "npm run check:readme && npm run check:bundle && npm run check:pack",
    "check:readme": "npx -y @floez-werk/pi-extension-release-tool@^0.1 sync-readme --check",
    "check:bundle": "npx -y esbuild@0.25.12 extensions/realtime-provider-cost.ts --bundle --format=esm --platform=node --external:@earendil-works/* --outfile=/tmp/realtime-provider-cost.mjs",
    "check:pack": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
